  "config": [
    {
      "key": "apiKey",
      "type": "password",
      "required": true,
      "default": "",
      "label": {
        "en": "Access token",
        "zh-CN": "访问令牌",
        "zh-TW": "存取權杖",
        "ja": "アクセストークン",
        "ko": "액세스 토큰"
      },
      "placeholder": {
        "en": "Paste your token",
        "zh-CN": "粘贴你的访问令牌",
        "zh-TW": "貼上你的存取權杖",
        "ja": "トークンを貼り付け",
        "ko": "토큰 붙여넣기"
      },
      "help": {
        "en": "Authorize at https://inscura.app/auth/bangumi, then paste the access token here. Reauthorize after it expires. No App ID or App Secret is required.",
        "zh-CN": "在 https://inscura.app/auth/bangumi 完成授权，将访问令牌粘贴到这里。到期后重新授权，无需填写 App ID 或 App Secret。",
        "zh-TW": "在 https://inscura.app/auth/bangumi 完成授權，將存取權杖貼到這裡。到期後重新授權，不必填寫 App ID 或 App Secret。",
        "ja": "https://inscura.app/auth/bangumi で認証し、アクセストークンを貼り付けてください。期限切れ後は再認証してください。App ID や App Secret は不要です。",
        "ko": "https://inscura.app/auth/bangumi 에서 인증한 뒤 액세스 토큰을 붙여 넣으세요. 만료 후에는 다시 인증하세요. App ID나 App Secret은 필요하지 않습니다."
      }
    },
    {
      "key": "includeImages",
      "type": "boolean",
      "required": false,
      "default": true,
      "label": {
        "en": "Include remote images",
        "zh-CN": "返回远程图片",
        "zh-TW": "傳回遠端圖片",
        "ja": "リモート画像を含める",
        "ko": "원격 이미지 포함"
      },
      "help": {
        "en": "Return available poster, backdrop and photo URLs. Images are core assets; the recommended default is enabled. Source image terms still apply.",
        "zh-CN": "返回可用的海报、背景图和照片地址。图片是核心资产，推荐默认开启。仍须遵守来源图片使用条款。",
        "zh-TW": "傳回可用的海報、背景圖和照片網址。圖片是核心資產，建議預設開啟。仍須遵守來源圖片使用條款。",
        "ja": "利用可能なポスター、背景画像、写真の URL を返します。画像は重要な資産のため既定での有効化を推奨します。提供元の画像利用条件が適用されます。",
        "ko": "사용 가능한 포스터, 배경 및 사진 URL을 반환합니다. 이미지는 핵심 자산이므로 기본 활성화를 권장합니다. 출처의 이미지 이용 약관이 적용됩니다."
      }
    }
  ],
