{
  "id": "inscura-plugin-bangumi",
  "name": "Bangumi 番组计划",
  "version": "1.0.0",
  "description": "Bangumi anime series, animated films, voice actors and creators. Authorize on inscura.app, then paste your access token.",
  "author": "InscuraApp",
  "homepage": "https://github.com/InscuraApp/inscura-plugin-bangumi",
  "apiVersion": 1,
  "entry": "index.js",
  "capabilities": [
    "media",
    "tv",
    "actor"
  ],
  "providers": {
    "media": [
      {
        "id": "bangumi",
        "label": {
          "en": "Bangumi",
          "zh-CN": "Bangumi",
          "zh-TW": "Bangumi",
          "ja": "Bangumi",
          "ko": "Bangumi"
        }
      }
    ],
    "tv": [
      {
        "id": "bangumi",
        "label": {
          "en": "Bangumi",
          "zh-CN": "Bangumi",
          "zh-TW": "Bangumi",
          "ja": "Bangumi",
          "ko": "Bangumi"
        }
      }
    ],
    "actor": [
      {
        "id": "bangumi",
        "label": {
          "en": "Bangumi",
          "zh-CN": "Bangumi",
          "zh-TW": "Bangumi",
          "ja": "Bangumi",
          "ko": "Bangumi"
